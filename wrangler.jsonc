{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidequestforge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
  // After the first deploy, attach the domain:
  // "routes": [{ "pattern": "sidequestforge.com", "custom_domain": true }, { "pattern": "www.sidequestforge.com", "custom_domain": true }]
}
