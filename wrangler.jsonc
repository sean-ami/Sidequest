{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidequestmaidens",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // The vote API reads games/votes/<set>/set.json and games/games.json through this binding.
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* and /admin/* reach the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*", "/admin/*"]
  },
  "observability": { "enabled": true },
  // Per-video visit counter (worker/index.ts). SQLite-backed Durable Objects run on the free plan
  // and need no dashboard setup. Reading /api/stats needs a STATS_KEY secret (see README).
  // Side Quest Vote store (VoteBox) uses the same pattern. Set a VOTE_SALT secret (public/games/README.md).
  "durable_objects": {
    "bindings": [
      { "name": "STATS", "class_name": "StatsCounter" },
      { "name": "VOTES", "class_name": "VoteBox" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["StatsCounter"] },
    { "tag": "v2", "new_sqlite_classes": ["VoteBox"] }
  ],
  // Custom domains: Cloudflare creates the DNS records on deploy. The zone must be in the same
  // account, and any existing A/AAAA/CNAME records on these hostnames must be deleted first.
  "routes": [
    { "pattern": "sidequestmaidens.com", "custom_domain": true },
    { "pattern": "www.sidequestmaidens.com", "custom_domain": true }
    // add other domains (e.g. sidequestforge.com) here to serve the same site on them too
  ]
}
