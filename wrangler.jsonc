{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sidequestforge",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    // Only /api/* reaches the Worker; everything else is served straight from static assets.
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Custom domains: Cloudflare creates the DNS records on deploy. The zone must be in the same
  // account, and any existing A/AAAA/CNAME records on these hostnames must be deleted first.
  "routes": [
    { "pattern": "sidequestmaidens.com", "custom_domain": true },
    { "pattern": "www.sidequestmaidens.com", "custom_domain": true }
    // add sidequestforge.com here too to serve the same site on both domains
  ]
}
